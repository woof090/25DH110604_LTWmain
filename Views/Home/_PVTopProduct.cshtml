
@model _25DH110604_LTW.Models.ViewModel.ProductDetailsVM
@using PagedList.Mvc

@if (Model.TopProducts != null && Model.TopProducts.Any())
{
    <section class="container-fluid listProduct">
        <h4 style="font-weight:bold;">Sản phẩm bán chạy</h4>
        <ul class="list-container">
            @foreach (var product in Model.TopProducts)
            {
                <li class="lproduct-item">
                    <a href="@Url.Action("ProductDetails", "AllHome", new { id = product.ProductID })">
                        <img src="@product.ProductImage" />
                    </a>
                    <h5>@product.ProductName</h5>
                    <p class="prodSale">@product.ProductPrice.ToString("N0")</p>
                </li>
            }
        </ul>
    </section>

    <div class="pagination-container">
        @Html.PagedListPager(Model.TopProducts, page => Url.Action("ProductDetails",
            new { id = Model.product.ProductID, quantity = Model.quantity, page }))
    </div>
}